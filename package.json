{
  "name": "crypto-price-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for tracking cryptocurrency prices from CoinMarketCap",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.cjs dist",
    "build:test": "tsc -p tsconfig.test.json && node scripts/copy-migrations.cjs .test-build/src",
    "start": "node dist/server.js",
    "test": "npm run build:test && jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dotenv": "18.0.6",
    "express": "4.22.3",
    "sqlite3": "5.1.7",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "^18.19.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3"
  }
}
