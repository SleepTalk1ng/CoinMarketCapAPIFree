# Two independent secrets. Replace these placeholders locally.
SERVICE_API_KEY=replace-with-a-random-service-key
CMC_API_KEY=replace-with-your-coinmarketcap-key

PORT=3000
DATABASE_PATH=./data/app.sqlite
CMC_TIMEOUT_MS=5000
# For continuous Basic-plan usage with one batch, consider 300000.
SYNC_INTERVAL_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
